Package: dbSequence
Title: DuckDB-Backed Interface for Large-Scale Genomic Data
Version: 0.99.1
Authors@R: 
    c(
        person("Edward C.", "Ruiz", , "ecr7407@gmail.com", role = c("aut", "cre"),
               comment = c(ORCID = "0000-0002-9174-5387")),
        person("Ruben", "Dries", role = "rev"),
